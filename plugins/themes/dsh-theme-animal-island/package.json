{
  "name": "@local/dsh-theme-animal-island",
  "version": "1.5.0",
  "scripts": { "test": "node --test theme.test.js" },
  "private": true,
  "description": "Animal Island styling for the DSH desktop client: parchment days, warm-charcoal nights with restrained mint accents, Nunito type, eight island accents, and three contour styles in Settings.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE-Nunito.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
