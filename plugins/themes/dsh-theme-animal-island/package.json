{
  "name": "@local/dsh-theme-animal-island",
  "version": "1.0.0",
  "private": true,
  "description": "Animal Island (animal-island-ui) styling for the DSH desktop client: warm parchment surfaces, mint accents, chunky rounded corners, Nunito type, and an island accent picker in Settings.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE-Nunito.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
