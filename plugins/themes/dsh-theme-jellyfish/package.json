{
  "name": "@local/dsh-theme-jellyfish",
  "version": "0.8.3",
  "scripts": {
    "test": "node --test theme.test.js"
  },
  "private": true,
  "description": "Independent JELEE Purple / Blue desktop appearances with persistent local controls, denser visible bubbles and fish, motion controls, opaque panels and a coordinated JELEE HARNESS brand.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./jelee-logo": "./jelee-logo.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts/*.ttf",
    "README.md",
    "DESIGN.md",
    "LICENSE-Nunito.txt",
    "LICENSE-Baloo2.txt",
    "LICENSE-SpaceMono.txt",
    "LICENSE-MaokenZhuyuanTi.txt",
    "LICENSE-975MaruSC.txt",
    "jelee-logo.svg",
    "THIRD-PARTY-NOTICES.md",
    "jelee-jellyfish.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
